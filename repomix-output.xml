<file path="app/agent/tools/factory.py">
"""
Per-request construction of the agent's tools.

Owner: Dev B (Retrieval & Tools)

WHY A FACTORY RATHER THAN PLAIN FUNCTIONS
-----------------------------------------
Dev C's tool protocols do not include `learner_id` — `search_curriculum` takes
only `(query, course_id, module_id?)`. But every retrieval must be scoped to
the learner, or the RBAC guarantee is not a guarantee.

Binding the learner (and the DB session) at construction resolves that without
changing a single documented signature: the graph keeps calling the tools
exactly as specified, and there is no argument a node could forget to pass or
pass wrongly. Build one `AgentTools` per request, in Dev D's service layer,
from the authenticated user.

`as_mapping()` returns exactly the four tool keyword arguments that Dev C's
`AgentDependencies` expects, so wiring is a single splat:

    from app.agent.graph.build import build_agent_graph
    from app.agent.graph.nodes import AgentDependencies

    tools = AgentTools.for_learner(session, current_user.id)
    deps = AgentDependencies(llm=llm_client, **tools.as_mapping())
    graph = build_agent_graph(deps)

Build the graph per request too, or cache it per learner — never share one
graph across learners, since the tools inside it carry a learner id.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Any

from sqlmodel import Session

from app.agent.repository import DEFAULT_SEARCH_LIMIT, AgentRepository
from app.agent.tools.escalate_to_trainer import make_escalate_to_trainer
from app.agent.tools.get_assignment_brief import make_get_assignment_brief
from app.agent.tools.search_curriculum import make_search_curriculum
from app.agent.tools.search_faqs import make_search_faqs


@dataclass(frozen=True)
class AgentTools:
    """
    The agent's four tools, all scoped to one learner.

    Attribute names match the tool names in the design document, so the
    mapping to Dev C's protocols is one-to-one.
    """

    repository: AgentRepository
    search_curriculum: Any
    search_faqs: Any
    get_assignment_brief: Any
    escalate_to_trainer: Any

    @classmethod
    def for_learner(
        cls,
        session: Session,
        learner_id: int,
        *,
        limit: int = DEFAULT_SEARCH_LIMIT,
        min_score: float | None = None,
    ) -> "AgentTools":
        """
        Build the tool set for one learner.

        Args:
            session: an open DB session (FastAPI's `get_session` dependency).
            learner_id: the *authenticated* user's id. Never take this from
                the request body — it is the entire access control boundary.
            limit: default chunks per search.
            min_score: optional similarity floor applied to both searches.
        """
        repository = AgentRepository(session=session, learner_id=learner_id)
        return cls(
            repository=repository,
            search_curriculum=make_search_curriculum(
                repository, limit=limit, min_score=min_score
            ),
            search_faqs=make_search_faqs(
                repository, limit=limit, min_score=min_score
            ),
            get_assignment_brief=make_get_assignment_brief(repository),
            escalate_to_trainer=make_escalate_to_trainer(repository),
        )

    @property
    def learner_id(self) -> int:
        """The learner every tool in this set is scoped to."""
        return self.repository.learner_id

    def as_mapping(self) -> dict[str, Any]:
        """The four tools keyed by name, for injection into the graph."""
        return {
            "search_curriculum": self.search_curriculum,
            "search_faqs": self.search_faqs,
            "get_assignment_brief": self.get_assignment_brief,
            "escalate_to_trainer": self.escalate_to_trainer,
        }
</file>

<file path="app/agent/tools/get_assignment_brief.py">
"""
Tool: get_assignment_brief — structured lookup of one assignment.

Owner: Dev B (Retrieval & Tools)

This is a direct lookup, not a similarity search: the graph already knows which
assignment the learner is asking about, so guessing at it via embeddings would
only add a way to be wrong.

Returns the structured `AssignmentBrief`, not a pre-formatted string. That
changed when Dev C's graph merged: rendering the brief into prompt text is a
prompt-design decision and now lives in `prompts/assignment_guidance.py`
(`_format_assignment_brief`). This module deliberately no longer formats
anything, so there is exactly one place that decides how a due date or a
maximum score gets phrased to the model.
"""

from __future__ import annotations

import logging
from typing import Callable

from app.agent.repository import AgentRepository
from app.agent.types import AssignmentBrief

logger = logging.getLogger(__name__)

GetAssignmentBrief = Callable[[int], "AssignmentBrief | None"]


def make_get_assignment_brief(
    repository: AgentRepository,
) -> GetAssignmentBrief:
    """Build a `get_assignment_brief` bound to one learner's repository."""

    def get_assignment_brief(assignment_id: int) -> AssignmentBrief | None:
        """
        Look up an assignment brief the learner is entitled to see.

        Args:
            assignment_id: the assignment to fetch.

        Returns:
            The structured brief, or None when the assignment does not exist,
            is inactive, or the learner is not enrolled in its course. Those
            cases are not distinguished, so this cannot be used to probe which
            assignment ids exist.
        """
        if assignment_id is None:
            return None

        try:
            normalised_id = int(assignment_id)
        except (TypeError, ValueError):
            logger.warning(
                "get_assignment_brief called with a non-numeric id: %r",
                assignment_id,
            )
            return None

        return repository.get_assignment(normalised_id)

    return get_assignment_brief
</file>

<file path="app/agent/tools/search_faqs.py">
"""
Tool: search_faqs — same index as curriculum search, filtered to FAQ content.

Owner: Dev B (Retrieval & Tools)

`course_id` is REQUIRED, matching `SearchFaqsFn` in graph/contracts.py.

An earlier revision made it optional, to hedge against the still-open question
of whether KodeCamp's FAQs are per-course or general. That hedge is withdrawn:
an implementation that disagrees with its own published contract is worse than
one that is provisionally too narrow. The graph passes `course_id` on every
call today (nodes.py::retrieve), so nothing is lost by requiring it.

If the FAQs turn out to be general rather than per-course, widening this back
to `int | None` is a backward-compatible change — adding a default breaks no
existing caller — and the repository already supports it (`search_content`
treats `course_id=None` as "every course this learner is enrolled in").
Whichever way it lands, access does not widen: the underlying query joins
`course_learners` regardless, so an unscoped FAQ search would still cover the
learner's own courses and nothing else.
"""

from __future__ import annotations

import logging
from typing import Callable

from app.agent.embedding_seam import embed_query
from app.agent.repository import DEFAULT_SEARCH_LIMIT, AgentRepository
from app.agent.types import FAQ, RetrievedChunk

logger = logging.getLogger(__name__)

SearchFaqs = Callable[..., "list[RetrievedChunk]"]


def make_search_faqs(
    repository: AgentRepository,
    *,
    limit: int = DEFAULT_SEARCH_LIMIT,
    min_score: float | None = None,
) -> SearchFaqs:
    """Build a `search_faqs` bound to one learner's repository."""

    def search_faqs(
        *,
        query: str,
        course_id: int,
    ) -> list[RetrievedChunk]:
        """
        Search FAQ content the learner is entitled to see.

        Args:
            query: the learner's question, in natural language.
            course_id: course to search within. Required, per SearchFaqsFn.

        Returns:
            Chunks ordered most-similar first; empty when nothing matches.

        Raises:
            EmbeddingUnavailableError: the query could not be embedded.
            ContentStoreUnavailableError: the embeddings table is missing.
        """
        if not query or not query.strip():
            logger.debug("search_faqs called with a blank query.")
            return []

        embedding = embed_query(query)
        return repository.search_content(
            query_embedding=embedding,
            course_id=course_id,
            content_type=FAQ,
            limit=limit,
            min_score=min_score,
        )

    return search_faqs
