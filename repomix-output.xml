from datetime import datetime, timezone

from sqlmodel import Session, select

from app.features.assignments.model import Assignment
from app.features.assignments.schema import (
    AssignmentCreate,
    AssignmentUpdate,
)
from app.features.auth.model import User


class AssignmentRepository:

    def __init__(self, db: Session):
        self.db = db

    def create(
        self,
        assignment_data: AssignmentCreate,
        module_id: int,
        created_by: int,
    ) -> Assignment:

        assignment = Assignment(
            **assignment_data.model_dump(),
            module_id=module_id,
            created_by=created_by,
            is_active=True,
        )

        self.db.add(assignment)
        self.db.commit()
        self.db.refresh(assignment)

        return assignment

    def get_all_assignment(
        self,
        module_id: int | None = None,
    ) -> list[Assignment]:

        statement = select(Assignment).where(
            Assignment.is_active == True
        )

        if module_id is not None:
            statement = statement.where(
                Assignment.module_id == module_id
            )

        statement = statement.order_by(Assignment.due_date)

        return list(self.db.exec(statement).all())

    def get_assignment_by_id(
        self,
        module_id: int,
        assignment_id: int,
    ) -> Assignment | None:

        statement = select(Assignment).where(
            Assignment.id == assignment_id,
            Assignment.module_id == module_id,
            Assignment.is_active == True,
        )

        return self.db.exec(statement).first()

    def get_creator_name(self, created_by: int) -> str | None:

        user = self.db.get(User,created_by)

        if user is None:
            return None

        return user.full_name or user.email

    def update(
        self,
        assignment: Assignment,
        assignment_data: AssignmentUpdate,
    ) -> Assignment:

        update_data = assignment_data.model_dump(
            exclude_unset=True
        )

        for key, value in update_data.items():
            setattr(assignment, key, value)

        assignment.updated_at = datetime.now(timezone.utc)

        self.db.add(assignment)
        self.db.commit()
        self.db.refresh(assignment)

        return assignment

    def delete(
        self,
        assignment: Assignment,
    ) -> Assignment:

        assignment.is_active = False
        assignment.updated_at = datetime.now(timezone.utc)

        self.db.add(assignment)
        self.db.commit()
        self.db.refresh(assignment)

        return assignment
