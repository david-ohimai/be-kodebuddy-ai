from fastapi import HTTPException

from app.features.auth.model import User, UserRole
from app.features.cohorts.repository.cohort_assign_repo import (
    CohortAssignRepository,
)
from app.features.cohorts.repository.repository import CohortRepository



class CohortAssignService:

    def __init__(
        self,
        repository: CohortAssignRepository,
        cohort_repository: CohortRepository,
    ):
        self.repository = repository
        self.cohort_repository = cohort_repository

    def assign_learner(
        self,
        cohort_id: int,
        learner_id: int,
    ):
        cohort = self.cohort_repository.get_by_id(cohort_id)

        if cohort is None:
            raise HTTPException(
                status_code=404,
                detail="Cohort not found",
            )

        existing = self.repository.get_learner_assignment(
            cohort_id,
            learner_id,
        )

        # Already assigned and active
        if existing and existing.is_active:
            raise HTTPException(
                status_code=400,
                detail="Learner is already assigned to this cohort",
            )

        # Previously assigned but inactive
        if existing:
            existing.is_active = True
            existing.completed_at = None

            return self.repository.update_learner_assignment(
                existing
            )

        # Never assigned before
        return self.repository.assign_learner(
            cohort_id,
            learner_id,
        )

    def assign_trainer(
        self,
        cohort_id: int,
        trainer_id: int,
    ):
        cohort = self.cohort_repository.get_by_id(cohort_id)

        if cohort is None:
            raise HTTPException(
                status_code=404,
                detail="Cohort not found",
            )

        trainer = self.repository.get_user_by_id(trainer_id)

        if trainer is None:
            raise HTTPException(
                status_code=404,
                detail="User not found",
            )

        if trainer.role != UserRole.TRAINER:
            raise HTTPException(
                status_code=400,
                detail="Only users with the trainer role can be assigned as cohort trainers",
            )

        existing = self.repository.get_trainer_assignment(
            cohort_id,
            trainer_id,
        )

        # Already assigned and active
        if existing and existing.removed_at is None:
            raise HTTPException(
                status_code=400,
                detail="Trainer is already assigned to this cohort",
            )

        # Previously assigned but removed
        if existing:
            existing.removed_at = None

            return self.repository.update_trainer_assignment(
                existing
            )

        # Never assigned before
        return self.repository.assign_trainer(
            cohort_id,
            trainer_id,
        )

    def assign_mentor(
            self,
            cohort_id: int,
            mentor_id: int,
        ):
            cohort = self.cohort_repository.get_by_id(cohort_id)
    
            if cohort is None:
                raise HTTPException(
                    status_code=404,
                    detail="Cohort not found",
                )
    
            mentor = self.repository.get_user_by_id(mentor_id)
    
            if mentor is None:
                raise HTTPException(
                    status_code=404,
                    detail="User not found",
                )
    
            if mentor.role != UserRole.MENTOR:
                raise HTTPException(
                    status_code=400,
                    detail="Only users with the mentor role can be assigned as cohort mentors",
                )
    
            existing = self.repository.get_mentor_assignment(
                cohort_id,
                mentor_id,
            )
    
            # Already assigned and active
            if existing and existing.removed_at is None:
                raise HTTPException(
                    status_code=400,
                    detail="Mentor is already assigned to this cohort",
                )
    
            # Previously assigned but removed
            if existing:
                existing.removed_at = None
    
                return self.repository.update_mentor_assignment(
                    existing
                )
    
            # Never assigned before
            return self.repository.assign_mentor(
                cohort_id,
                mentor_id,
            )
    

    def get_learners(
        self,
        cohort_id: int,
    ):
        return self.repository.get_learners(cohort_id)

    def get_trainers(
        self,
        cohort_id: int,
    ):
        return self.repository.get_trainers(cohort_id)

    def get_mentors(self, cohort_id: int):
        cohort = self.cohort_repository.get_by_id(cohort_id)

        if cohort is None:
            raise HTTPException(
                status_code=404,
                detail="Cohort not found.",
            )

        return self.repository.get_mentors(cohort_id)
