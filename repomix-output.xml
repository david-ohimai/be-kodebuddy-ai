<file path="app/agent/graph/build.py">
"""
Compiles the graph nodes into a single runnable LangGraph StateGraph.

Owner: Dev C (Graph / Reasoning / Guardrails)

Graph shape:

    retrieve --[has usable context]--> reason -> confidence_gate ->
    route -> END
             -[no usable context]---> no_context -----------------^

"Usable context" means either at least one retrieved chunk, or — for
assignment guidance — an assignment brief. When neither is present, the
graph skips the LLM call entirely and routes straight to escalation via
`no_context`, rather than asking the model to answer from nothing.

Usage (by Dev D's service.py):

    from app.agent.graph.build import build_agent_graph
    from app.agent.graph.nodes import AgentDependencies

    deps = AgentDependencies(
        llm=real_llm_client,                              # Dev D
        search_curriculum=real_search_curriculum,           # Dev B
        search_faqs=real_search_faqs,                         # Dev B
        get_assignment_brief=real_get_assignment_brief,       # Dev B
        escalate_to_trainer=real_escalate_to_trainer,         # Dev B
    )
    graph = build_agent_graph(deps)
    result_state = graph.invoke(initial_state)  # initial_state: AgentState

Wiring tracing (Dev E):
    LangSmith/Langfuse tracing is added by wrapping the callables passed into
    AgentDependencies (e.g. an LLMClient whose .complete() is @traceable, or
    tool functions wrapped before being passed in) — this file and nodes.py
    don't need to change for that.
"""

from __future__ import annotations

from langgraph.graph import END, StateGraph

from app.agent.graph.nodes import (
    AgentDependencies,
    make_confidence_gate_node,
    make_no_context_node,
    make_reason_node,
    make_retrieval_error_node,
    make_retrieve_node,
    make_route_node,
)
from app.agent.graph.state import AgentState, QueryType

__all__ = ["AgentDependencies", "build_agent_graph"]


def _route_after_retrieve(state: AgentState) -> str:
    """Conditional-edge router: decides what `retrieve` found — a genuine
    infrastructure failure, nothing usable, or enough to reason over."""
    if state.get("retrieval_failed"):
        return "retrieval_error"

    has_chunks = bool(state.get("retrieved_chunks"))
    has_brief = (
        state.get("query_type") == QueryType.ASSIGNMENT_GUIDANCE
        and state.get("assignment_brief") is not None
    )
    return "reason" if (has_chunks or has_brief) else "no_context"


def build_agent_graph(deps: AgentDependencies):
    """
    Wires retrieve -> [reason -> confidence_gate | no_context] -> route into
    a compiled, invokable graph.

    `route` is a single node that internally branches on `is_confident`
    (rather than a further conditional edge to two separate terminal nodes)
    — both branches need the same inputs and produce the same output shape,
    so a plain if/else inside one node is simpler than a graph-level branch
    there, with no loss of clarity in the trace.
    """
    graph = StateGraph(AgentState)

    graph.add_node("retrieve", make_retrieve_node(deps))
    graph.add_node("reason", make_reason_node(deps))
    graph.add_node("confidence_gate", make_confidence_gate_node())
    graph.add_node("no_context", make_no_context_node())
    graph.add_node("retrieval_error", make_retrieval_error_node())
    graph.add_node("route", make_route_node(deps))

    graph.set_entry_point("retrieve")
    graph.add_conditional_edges(
        "retrieve",
        _route_after_retrieve,
        {
            "reason": "reason",
            "no_context": "no_context",
            "retrieval_error": "retrieval_error",
        },
    )
    graph.add_edge("reason", "confidence_gate")
    graph.add_edge("confidence_gate", "route")
    graph.add_edge("no_context", "route")
    graph.add_edge("retrieval_error", "route")
    graph.add_edge("route", END)

    return graph.compile()
</file>

<file path="app/agent/prompts/fallback.py">
"""
Prompt for the reason-specific "I'm not confident" message shown to a
learner when `route` decides to offer escalation instead of a confident
answer.

Owner: Dev C (Graph / Reasoning / Guardrails)

Kept separate from prompts/chat.py and prompts/assignment_guidance.py since
this prompt writes a short UI-facing status message, not a
question-answering completion — it doesn't take context chunks or chat
history, and its output is plain prose rather than the {"answer",
"uncertain"} JSON shape `_parse_llm_response` expects.
"""

from __future__ import annotations

from app.agent.graph.state import EscalationReason

FALLBACK_MESSAGE_SYSTEM_PROMPT = """
You write a single short message (1-2 sentences, no markdown headers) telling a 
learner that the agent isn't confident enough in an answer to their question. 
Be warm but brief -- don't over-apologize. Base the message ONLY on the reason 
given to you; never invent a cause, never mention specific scores/thresholds, 
and never reference an escalation button or trainer follow-up (that's added 
separately). Output only the message text, nothing else."""


_REASON_CONTEXT: dict[EscalationReason, str] = {
    EscalationReason.NO_RELEVANT_CONTEXT: (
        "No relevant course material could be found for this question."
    ),
    EscalationReason.LOW_RETRIEVAL_CONFIDENCE: (
        "The course material found only weakly matches this question."
    ),
    EscalationReason.MODEL_UNCERTAINTY: (
        "The model itself flagged its own answer as uncertain."
    ),
    EscalationReason.POLICY_VIOLATION: (
        "The draft would have handed over a full assignment solution, so "
        "it can't be shown."
    ),
    EscalationReason.PARSER_FAILURE: (
        "The model's response came back in an unexpected format."
    ),
    EscalationReason.RETRIEVAL_UNAVAILABLE: (
        "The course-material search was unavailable when answering."
    ),
    EscalationReason.EXPLICIT_USER_REQUEST: (
        "The learner asked to speak with their trainer directly."
    ),
}


def build_fallback_user_turn(
    *,
    reason: EscalationReason,
    detail: str | None,
    question: str,
    has_draft: bool,
) -> str:
    """
    Builds the user turn for FALLBACK_MESSAGE_SYSTEM_PROMPT.

    `has_draft` tells the model whether a draft answer will be shown right
    after its message (so it can, e.g., say "here's what I found" style
    framing) without actually handing the model the draft content itself --
    the draft is appended by `route` verbatim, never paraphrased by the LLM.
    """
    lines = [
        f"Learner's question: {question}",
        f"Why we're not confident: {_REASON_CONTEXT[reason]}",
    ]
    if detail:
        lines.append(f"Additional detail: {detail}")
    lines.append(
        "A partial draft answer will be shown right after your message."
        if has_draft
        else "No draft answer exists to show."
    )
    return "\n".join(lines)
</file>

<file path="app/agent/tools/search_curriculum.py">
"""
Tool: search_curriculum — scoped similarity search over module content.

Owner: Dev B (Retrieval & Tools)

Matches Dev C's `SearchCurriculumFn` protocol. The learner is bound when the
tool is built rather than passed per call, so RBAC scoping cannot be omitted or
spoofed by the caller; see `app.agent.repository` for the enforcing join.
"""

from __future__ import annotations

import logging
from typing import Callable

from app.agent.embedding_seam import embed_query
from app.agent.repository import DEFAULT_SEARCH_LIMIT, AgentRepository
from app.agent.types import CURRICULUM, RESOURCE, RetrievedChunk

logger = logging.getLogger(__name__)

SearchCurriculum = Callable[..., "list[RetrievedChunk]"]

MODULE_CONTENT_TYPES = (CURRICULUM, RESOURCE)


def make_search_curriculum(
    repository: AgentRepository,
    *,
    limit: int = DEFAULT_SEARCH_LIMIT,
    min_score: float | None = None,
) -> SearchCurriculum:
    """Build a `search_curriculum` bound to one learner's repository."""

    def search_curriculum(
        *,
        query: str,
        course_id: int,
        module_id: int | None = None,
    ) -> list[RetrievedChunk]:
        """
        Search curriculum content the learner is entitled to see.

        Args:
            query: the learner's question, in natural language.
            course_id: course to search within.
            module_id: optional module to narrow to.

        Returns:
            Chunks ordered most-similar first. Empty when nothing relevant is
            found *or* when the learner is not enrolled in `course_id` — the
            two are intentionally indistinguishable to the caller.

        Raises:
            EmbeddingUnavailableError: the query could not be embedded.
            ContentStoreUnavailableError: the embeddings table is missing.

            Both are raised rather than returned as an empty list, because a
            caller cannot otherwise tell "searched, found nothing" from "never
            actually searched" — and the second must not be answered as if it
            were the first.
        """
        if not query or not query.strip():
            logger.debug("search_curriculum called with a blank query.")
            return []

        embedding = embed_query(query)
        return repository.search_content(
            query_embedding=embedding,
            course_id=course_id,
            module_id=module_id,
            content_type=MODULE_CONTENT_TYPES,
            limit=limit,
            min_score=min_score,
        )

    return search_curriculum
</file>

<file path="app/agent/types.py">
"""
Errors and content-type vocabulary for the retrieval tools.

Owner: Dev B (Retrieval & Tools)

The shared data shapes — `RetrievedChunk`, `AssignmentBrief`,
`EscalationReason` — are NOT defined here. They live in
`app.agent.graph.state`, owned by Dev C, and are re-exported below so callers
of this package have one import site.

This file used to carry its own structural copies of those types, from before
the graph existed on `dev`. That is now a liability rather than a convenience:
two definitions of the same shape drift silently (the `due_date` type already
diverged once — `date` here, ISO-8601 `str` there). `state.py` imports nothing
from this package, so depending on it introduces no cycle.

CHANGE: added `ASSIGNMENT` content type
-----------------------------------------
Assignments were previously not embedded at all — `get_assignment_brief` is
a direct-by-id lookup, not a similarity search, and a learner asking a
general question that merely *touches* an assignment (no id in context) had
nothing to retrieve against. `ASSIGNMENT` lets assignment title/description/
instructions/requirements be embedded and searched the same way curriculum
and resources are (see `app.agent.tools.search_assignments`), without
touching the existing id-based lookup path at all.
"""

from __future__ import annotations

from typing import Literal

from app.agent.graph.state import (
    AssignmentBrief,
    EscalationReason,
    RetrievedChunk,
)

# Values stored in `content_embeddings.content_type` (Dev A's table).
ContentType = Literal["curriculum", "faq", "resource", "assignment"]

CURRICULUM: ContentType = "curriculum"
FAQ: ContentType = "faq"
RESOURCE: ContentType = "resource"
ASSIGNMENT: ContentType = "assignment"


# --------------------------------------------------------------------------
# Errors
# --------------------------------------------------------------------------


class AgentRetrievalError(RuntimeError):
    """Base class for every failure raised by the retrieval layer."""


class EmbeddingUnavailableError(AgentRetrievalError):
    """
    Dev A's embedding provider is missing, misconfigured, or failed.

    Raised rather than returning `[]` because an empty result is
    indistinguishable from "no relevant content", which would cause the
    confidence gate to escalate a question that was never actually searched.
    """


class ContentStoreUnavailableError(AgentRetrievalError):
    """
    The `content_embeddings` table (or the pgvector extension) is not present.

    Expected until Dev A's migration has been applied. Distinct from "no
    results" for the same reason as `EmbeddingUnavailableError`.
    """


class EscalationWriteError(AgentRetrievalError):
    """The escalation record could not be persisted."""


__all__ = [
    "AgentRetrievalError",
    "ASSIGNMENT",
    "AssignmentBrief",
    "CURRICULUM",
    "ContentStoreUnavailableError",
    "ContentType",
    "EmbeddingUnavailableError",
    "EscalationReason",
    "EscalationWriteError",
    "FAQ",
    "RESOURCE",
    "RetrievedChunk",
]
</file>

