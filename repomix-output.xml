    # the downgrade will fail on the NOT NULL constraint. Backfill or delete
    # those rows first — e.g.:
    #   DELETE FROM content_embeddings WHERE course_id IS NULL;
    op.alter_column(
        'content_embeddings',
        'course_id',
        existing_type=sa.Integer(),
        nullable=False,
    )
