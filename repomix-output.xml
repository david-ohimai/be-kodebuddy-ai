<file path="app/agent/tools/search_curriculum.py">
"""
Tool: search_curriculum — scoped similarity search over module content.

Owner: Dev B (Retrieval & Tools)

Matches Dev C's `SearchCurriculumFn` protocol. The learner is bound when the
tool is built rather than passed per call, so RBAC scoping cannot be omitted or
spoofed by the caller; see `app.agent.repository` for the enforcing join.
"""

from __future__ import annotations

import logging
from typing import Callable

from app.agent.embedding_seam import embed_query
from app.agent.repository import DEFAULT_SEARCH_LIMIT, AgentRepository
from app.agent.types import CURRICULUM, RetrievedChunk

logger = logging.getLogger(__name__)

SearchCurriculum = Callable[..., "list[RetrievedChunk]"]


def make_search_curriculum(
    repository: AgentRepository,
    *,
    limit: int = DEFAULT_SEARCH_LIMIT,
    min_score: float | None = None,
) -> SearchCurriculum:
    """Build a `search_curriculum` bound to one learner's repository."""

    def search_curriculum(
        *,
        query: str,
        course_id: int,
        module_id: int | None = None,
    ) -> list[RetrievedChunk]:
        """
        Search curriculum content the learner is entitled to see.

        Args:
            query: the learner's question, in natural language.
            course_id: course to search within.
            module_id: optional module to narrow to.

        Returns:
            Chunks ordered most-similar first. Empty when nothing relevant is
            found *or* when the learner is not enrolled in `course_id` — the
            two are intentionally indistinguishable to the caller.

        Raises:
            EmbeddingUnavailableError: the query could not be embedded.
            ContentStoreUnavailableError: the embeddings table is missing.

            Both are raised rather than returned as an empty list, because a
            caller cannot otherwise tell "searched, found nothing" from "never
            actually searched" — and the second must not be answered as if it
            were the first.
        """
        if not query or not query.strip():
            logger.debug("search_curriculum called with a blank query.")
            return []

        embedding = embed_query(query)
        return repository.search_content(
            query_embedding=embedding,
            course_id=course_id,
            module_id=module_id,
            content_type=CURRICULUM,
            limit=limit,
            min_score=min_score,
        )

    return search_curriculum
</file>

<file path="app/agent/types.py">
"""
Errors and content-type vocabulary for the retrieval tools.

Owner: Dev B (Retrieval & Tools)

The shared data shapes — `RetrievedChunk`, `AssignmentBrief`,
`EscalationReason` — are NOT defined here. They live in
`app.agent.graph.state`, owned by Dev C, and are re-exported below so callers
of this package have one import site.

This file used to carry its own structural copies of those types, from before
the graph existed on `dev`. That is now a liability rather than a convenience:
two definitions of the same shape drift silently (the `due_date` type already
diverged once — `date` here, ISO-8601 `str` there). `state.py` imports nothing
from this package, so depending on it introduces no cycle.
"""

from __future__ import annotations

from typing import Literal

from app.agent.graph.state import (
    AssignmentBrief,
    EscalationReason,
    RetrievedChunk,
)

# Values stored in `content_embeddings.content_type` (Dev A's table).
ContentType = Literal["curriculum", "faq", "resource"]

CURRICULUM: ContentType = "curriculum"
FAQ: ContentType = "faq"
RESOURCE: ContentType = "resource"


# --------------------------------------------------------------------------
# Errors
# --------------------------------------------------------------------------


class AgentRetrievalError(RuntimeError):
    """Base class for every failure raised by the retrieval layer."""


class EmbeddingUnavailableError(AgentRetrievalError):
    """
    Dev A's embedding provider is missing, misconfigured, or failed.

    Raised rather than returning `[]` because an empty result is
    indistinguishable from "no relevant content", which would cause the
    confidence gate to escalate a question that was never actually searched.
    """


class ContentStoreUnavailableError(AgentRetrievalError):
    """
    The `content_embeddings` table (or the pgvector extension) is not present.

    Expected until Dev A's migration has been applied. Distinct from "no
    results" for the same reason as `EmbeddingUnavailableError`.
    """


class EscalationWriteError(AgentRetrievalError):
    """The escalation record could not be persisted."""


__all__ = [
    "AgentRetrievalError",
    "AssignmentBrief",
    "CURRICULUM",
    "ContentStoreUnavailableError",
    "ContentType",
    "EmbeddingUnavailableError",
    "EscalationReason",
    "EscalationWriteError",
    "FAQ",
    "RESOURCE",
    "RetrievedChunk",
]
</file>

