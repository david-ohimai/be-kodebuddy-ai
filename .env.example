DATABASE_URL=postgresql+psycopg://your-username:your-password@localhost:5432/KodeBuddyAI

AUTH_SECRET_KEY=your_secret_key

INITIAL_ADMIN_PASSWORD=your-admin-password

ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=your-sender-name
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
FRONTEND_URL=https://your-frontend-domain.com

VOYAGE_API_KEY=your_voyage_api_key
VOYAGE_EMBED_MODEL=voyage-3

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=kodebuddy-agent

# --- agent LLM fallback chain (Dev D) ---
ANTHROPIC_API_KEY=
# Anthropic (primary) — already required elsewhere in your .env; the
# fallback tier reuses the same ANTHROPIC_API_KEY, just a different model.
AGENT_LLM_MODEL=claude-sonnet-5
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_FALLBACK_MODEL=claude-haiku-4-5-20251001

# Gemini
GEMINI_API_KEY=your_gemini_api_key
AGENT_LLM_GEMINI_MODEL=gemini-2.5-flash
AGENT_LLM_GEMINI_MAX_TOKENS=2048

# Groq
GROQ_API_KEY=your_groq_api_key
AGENT_LLM_GROQ_MODEL=llama-3.3-70b-versatile
AGENT_LLM_GROQ_MAX_TOKENS=2048

# OpenRouter (OpenAI-compatible API — uses the `openai` package as its
# client library, not an OPENAI_API_KEY)
OPENROUTER_API_KEY=your_openrouter_api_key
AGENT_LLM_OPENROUTER_MODEL=anthropic/claude-3.5-haiku
AGENT_LLM_OPENROUTER_MAX_TOKENS=2048